# Required
OPENROUTER_API_KEY=your_key_here

# Optional — override model defaults (one-line tier switching)
# LLM_MODEL=anthropic/claude-haiku-4.5       # dev/iteration (default)
# LLM_MODEL=anthropic/claude-sonnet-4.6      # eval runs and final system

# ASR_MODEL=openai/whisper-large-v3-turbo    # default
# EMBED_MODEL=BAAI/bge-small-en-v1.5         # default (local, no API key needed)

# Optional — ffmpeg paths (set if ffmpeg is installed but not in PATH)
# FFMPEG_BIN=D:\ffmpeg\ffmpeg-master-latest-win64-gpl\bin\ffmpeg.exe
# FFPROBE_BIN=D:\ffmpeg\ffmpeg-master-latest-win64-gpl\bin\ffprobe.exe

# Optional — pipeline tuning
# CHUNK_MINUTES=6
# TARGET_WORDS=200
# OVERLAP_WORDS=40
# TOP_K=5
# BUDGET_USD=10.0
